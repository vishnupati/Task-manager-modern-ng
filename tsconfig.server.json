{
    "extends": "./tsconfig.json",
    "compilerOptions": {
        "outDir": "./out-tsc/server",
        "types": [
            "node"
        ]
    },
    "angularCompilerOptions": {
        "extendedDiagnostics": {
            "checks": {
                "unusedStandaloneImports": "suppress"
            }
        }
    },
    "include": [
        "src/**/*.ts"
    ],
    "exclude": [
        "src/**/*.spec.ts"
    ]
}